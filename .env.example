# InboxPulse AI - Environment Configuration
# Team: KITSW WARRIOR | Track: SaaSsum AI (IT & AI)

# Google Gemini API Key (Required for AI email parsing & insights)
# In AI Studio this is automatically provided via user secrets.
# For standalone local run, obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Flask Application Settings
FLASK_ENV="development"
FLASK_DEBUG="1"
FLASK_SECRET_KEY="inboxpulse-warrior-secret-key-change-in-prod"
PORT="5000"

# Optional: Google OAuth 2.0 Credentials for Live Gmail Ingestion
# Create credentials in Google Cloud Console with Gmail API enabled (Scope: https://www.googleapis.com/auth/gmail.readonly)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"
